# =========================================================================
# Worknoon AI Support & Refund Agent - Environment Settings Template
# Copy this file to '.env' and provide your actual API keys to run.
# =========================================================================

# --- LLM API Configuration ---
# Provide at least one valid API key to enable real LLM intelligence.
# If neither key is provided, the backend resiliently boots into 'Safe-Mock Mode'
# using programmatic mock rule simulations for easy out-of-the-box evaluation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- MySQL Database Configuration (Inside Docker Compose) ---
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=noon_crm
MYSQL_USER=noon_admin
MYSQL_PASSWORD=noon_secure_pass
MYSQL_ROOT_PASSWORD=noon_root_pass
